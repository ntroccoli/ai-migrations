{
  // markdownlint-cli2 0.24.0 (the version in markdownlint-cli2-action v25.0.0).
  // Run: npx markdownlint-cli2@0.24.0 "**/*.md"
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD025": { "front_matter_title": "" },
    "MD024": { "siblings_only": true }
  },
  "ignores": ["node_modules/**", ".test-tmp/**"]
}
